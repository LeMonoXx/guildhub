BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
BATTLENET_REDIRECT_URI=http://localhost:3000/auth/callback
# Optional. Point at apps/battlenet-stub locally; leave unset for the real API.
# BATTLENET_API_BASE_URL=http://127.0.0.1:8787
# Optional. Aspire uses the real Battle.net when credentials are set. Force the stub with:
# BATTLENET_USE_STUB=1
INSTANCE_DIR=../../instances/traceless
DATABASE_URL=postgres://guildhub:guildhub@127.0.0.1:5432/guildhub
# Optional. How long a Battle.net guild snapshot stays fresh.
# GUILD_CACHE_TTL_SECONDS=300
# Optional. How long a character appearance snapshot stays fresh.
# CHARACTER_CACHE_TTL_SECONDS=900
# Optional. Baker output directory. The API checks looks/{hash}/look.json here.
# ASSET_ROOT=apps/model-baker/assets/fixed
# Optional. Current wowf build if current.json is not in ASSET_ROOT yet.
# MODEL_CLIENT_BUILD=1.60.1.70938
# Worker only. Path to GuildHub.ModelBaker.Cli.dll or an executable.
# BAKER_CLI=
# BAKER_CACHE=apps/model-baker/cache
# BAKER_REGION=eu
# Worker only. When the guild's day is recorded for the history, and in which time zone.
# HISTORY_CRON=0 * * * *
# HISTORY_TIME_ZONE=Europe/Berlin
SESSION_SECRET=
PORT=3000
LOG_LEVEL=info
OTEL_SERVICE_NAME=guildhub-api
# Optional. Aspire injects this; leave unset when no OTLP collector is running.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
