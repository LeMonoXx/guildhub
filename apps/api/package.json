{
  "name": "@guildhub/api",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle",
    "instrumentation-loader.mjs"
  ],
  "scripts": {
    "dev": "pnpm --filter @guildhub/contracts build && node --import ./instrumentation-loader.mjs --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node --import ./instrumentation-loader.mjs dist/index.js",
    "migrate": "node --import ./instrumentation-loader.mjs dist/migrate.js",
    "dev:migrate": "tsx src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@blizzard-api/client": "^5.5.6",
    "@blizzard-api/core": "^4.5.1",
    "@blizzard-api/wow-forever": "^0.3.2",
    "@guildhub/contracts": "workspace:*",
    "@hono/node-server": "^2.1.8",
    "@hono/otel": "^1.3.0",
    "@hono/structured-logger": "^1.0.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.1",
    "@opentelemetry/instrumentation": "0.301.1",
    "@opentelemetry/instrumentation-pino": "0.71.0",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.1",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.18",
    "pino": "^10.4.0",
    "postgres": "4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "catalog:",
    "drizzle-kit": "1.0.0-rc.5",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
