:8080 {
	@current path /assets/current.json
	handle @current {
		root * /srv
		header Cache-Control "no-cache"
		file_server
	}

	handle_path /assets/* {
		root * /srv/assets
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /auth/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
