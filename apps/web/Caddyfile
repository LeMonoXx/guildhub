:8080 {
	@current path /assets/current.json
	handle @current {
		root * /srv
		header Cache-Control "no-cache"
		file_server
	}

	handle_path /assets/* {
		root * /srv/assets
		# Bosses and maps keep their URL when a new game build rewrites them.
		@immutable {
			file
			not path /bosses/* /looks/boss-* /maps/*
		}
		@revalidate {
			file
			path /bosses/* /looks/boss-* /maps/*
		}
		@missing not file
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header @revalidate Cache-Control "no-cache"
		header @missing Cache-Control "no-store"
		file_server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /auth/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
