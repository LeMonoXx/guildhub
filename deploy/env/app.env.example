# Server copy: <deploy-dir>/app.env, mode 600. Passed into the api, worker,
# and migrate containers. Database and paths are set by compose.yaml.

# From https://develop.battle.net/access/clients
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
# https://<PUBLIC_HOST>/auth/callback, also registered on the Battle.net client.
BATTLENET_REDIRECT_URI=

# At least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=

LOG_LEVEL=info
OTEL_SERVICE_NAME=guildhub-api
BAKER_REGION=eu
HISTORY_TIME_ZONE=Europe/Berlin
