# Server copy: <deploy-dir>/.env, mode 600. Read by Docker Compose only.

# Directory name under instances/ that the images were built with.
GUILDHUB_INSTANCE=
# ghcr.io/<github-owner-in-lowercase>/guildhub
GUILDHUB_IMAGE_PREFIX=
# Written by the deploy script. Full commit SHA of the running images.
GUILDHUB_TAG=

# Hostname Traefik routes to the web container, without https://.
PUBLIC_HOST=
# Names from the host's Traefik static configuration.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Letters and digits only; it is part of a connection URL.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
