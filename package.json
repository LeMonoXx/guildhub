{
  "name": "guildhub",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @guildhub/contracts --if-present build && pnpm -r --if-present typecheck",
    "test": "pnpm test:content-guard && pnpm -r --if-present test",
    "test:int": "pnpm --filter @guildhub/api test:int",
    "build": "pnpm -r --if-present build",
    "check:no-game-content": "node scripts/check-no-game-content.mjs",
    "test:content-guard": "node --test scripts/check-no-game-content.test.mjs",
    "boundaries": "depcruise apps/api/src apps/api/instrumentation-loader.mjs apps/battlenet-stub/src apps/web/src packages scripts --config .dependency-cruiser.cjs --validate",
    "verify": "pnpm format:check && pnpm lint && pnpm check:no-game-content && pnpm boundaries && pnpm --filter @guildhub/api db:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.2"
  }
}
